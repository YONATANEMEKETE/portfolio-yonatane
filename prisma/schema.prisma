generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One row per (route, visitor, UTC day). Counting is enforced by the unique
// constraint and an ON CONFLICT DO NOTHING insert, so repeat visits are free and
// concurrent requests can't double-count. The number on the card is count().
model PageView {
  id          String   @id @default(cuid())
  path        String
  visitorHash String
  day         DateTime @db.Date
  createdAt   DateTime @default(now())

  @@unique([path, visitorHash, day])
  @@index([createdAt])
}

// Yonatane's own addresses for passcode-reset links (auth.md). Plaintext, not
// hashed: the server must be able to send mail to them — masking happens on the
// way out. null verifiedAt = added but not yet confirmed via its verification
// link; only verified rows are ever selectable on /manage/reset (M5).
model RecipientEmail {
  id         String    @id @default(cuid())
  email      String    @unique
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Exactly one row (id = 1): the single owner's passcode, as an argon2id PHC
// string. In the DB rather than an env var so recovery can rotate it without a
// redeploy (auth.md). Never plaintext.
model AuthConfig {
  id           Int      @id @default(1)
  passcodeHash String
  updatedAt    DateTime @updatedAt
}

// One row per browser session. The raw 32-byte token lives only in the
// HttpOnly pf_session cookie; the DB keeps its SHA-256 plus expiry (30 days).
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Recovery + verification links share one lifecycle: a random 256-bit token
// (raw value only ever in the emailed URL), stored as SHA-256, expiring,
// single-use. purpose scopes the token; recipientEmailId ties a passcode-reset
// link to the address it was sent to — requesting a new link marks older
// unused ones used (auth.md), so only the newest email ever works.
model OneTimeToken {
  id               String    @id @default(cuid())
  tokenHash        String    @unique // sha256 of the raw token from the emailed link
  purpose          String // "passcode-reset" (email-verify dropped for now)
  recipientEmailId String?
  expiresAt        DateTime // 15 min for passcode-reset (auth.md)
  usedAt           DateTime?
  createdAt        DateTime  @default(now())
}
