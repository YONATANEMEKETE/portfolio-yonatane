# Copy to .env.local and fill in as milestones land. Never commit real values.

# M3 — Neon Postgres (pooled URL for runtime, direct URL for migrations)
# Use sslmode=verify-full in both: pg v9 will treat sslmode=require as the weaker
# libpq semantics, and verify-full is what require does today anyway.
# DATABASE_URL=
# DIRECT_URL=

# Salt for the salted hash of a visitor's ip (view dedupe). Must stay constant:
# changing it makes every visitor look new again. Generate with `openssl rand -hex 32`.
# VIEW_HASH_SALT=

# M5 — Resend (recovery + verification emails)
# RESEND_API_KEY=
# EMAIL_FROM=

# Site origin — used in metadata, sitemap, and email links
# NEXT_PUBLIC_SITE_URL=

# R2 — S3-compatible uploads for article covers (src/lib/r2.ts).
# Credentials are the Access Key ID / Secret pair (S3 API), not the API token.
# R2_PUBLIC_URL is the bucket's public base (r2.dev subdomain or custom domain).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...        ← the Access Key ID + Secret pair (S3 API)
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=portfolio-yonatan
# R2_PUBLIC_URL=...
